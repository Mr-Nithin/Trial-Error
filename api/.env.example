DATABASE_URL=postgres://arc:arc@localhost:5432/arc
PORT=4000
HOST=0.0.0.0
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=arc-media
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
COOKIE_SECURE=false
# Comma-separated origins allowed for CORS/CSRF (only needed when web isn't proxying /api)
WEB_ORIGIN=
# Trust X-Forwarded-* from a reverse proxy (client IP for rate limits, X-Forwarded-Host for CSRF)
TRUST_PROXY=false
SESSION_TTL_DAYS=30
LOG_LEVEL=info

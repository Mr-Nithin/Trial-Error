{
  "name": "arc-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf build dist && tsc -p tsconfig.build.json && node scripts/flatten-dist.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1149.0",
    "@aws-sdk/lib-storage": "~3.1149.0",
    "@fastify/cookie": "~11.1.3",
    "@fastify/cors": "~11.3.1",
    "@fastify/helmet": "~13.1.2",
    "@fastify/multipart": "~10.1.3",
    "@fastify/rate-limit": "~11.2.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "~5.12.5",
    "fastify-plugin": "~6.0.0",
    "fastify-type-provider-zod": "~7.0.0",
    "pg": "~8.23.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/pg": "~8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2",
    "vitest": "~5.0.3"
  }
}

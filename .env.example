# Copy to .env and change these before running `docker compose up` anywhere but your own machine.
POSTGRES_PASSWORD=arc
S3_ACCESS_KEY=arc-media
S3_SECRET_KEY=change-me-minio-secret
# The URL people open the app at; the API rejects state-changing requests from other origins.
WEB_ORIGIN=http://localhost:3000
# Set to true when serving over HTTPS so session cookies are Secure.
COOKIE_SECURE=false
